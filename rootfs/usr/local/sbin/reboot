#!/bin/sh
# Stub for PDM's "Reboot" UI button. Inside a container, the container
# orchestrator manages lifecycle, not /sbin/reboot. Tell the operator and
# exit cleanly instead of actually killing PID 1.
echo "[reboot-stub] reboot requested but suppressed: this PDM is a container." >&2
echo "[reboot-stub] Restart with 'docker compose restart pdm' from the host." >&2
exit 0
